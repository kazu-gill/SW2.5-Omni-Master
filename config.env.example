# ============================================================
#  Omni-Master 設定ファイル — テンプレート
#  このファイルをコピーして config.env を作成してください:
#    cp config.env.example config.env
#  config.env は .gitignore で管理対象外です。
# ============================================================

# ── データベース ──────────────────────────────────────────────
DB_PATH=/path/to/sw25-omni-master/data/omni.db

# ── Go サーバー ───────────────────────────────────────────────
ADDR=:8080

# ── ComfyUI（Windows 側または別マシン） ───────────────────────
# 画像生成を使わない場合は空文字のままにする
COMFY_URL=

# ── LLM (mlx-serve) ───────────────────────────────────────────
# Omni-Master は推論プロセスを起動しない。mlx-serve (/Users/kf/AI/MLX) で
# 次のプロファイルを起動しておくこと:
#   pwsh /Users/kf/AI/MLX/scripts/Start-MlxServe.ps1 -Profile gemma4-31b-it-heretic-4bit-mtp
#   pwsh /Users/kf/AI/MLX/scripts/Start-MlxServe.ps1 -Profile bge-m3-q8
#
# GM / NPC / Support はすべて同じチャットモデルを直列で呼ぶ。
# model ID は mlx-serve のプロファイルの model_id と一致させること
# (違う名前を送ると mlx-serve 側で常駐モデルが入れ替わる)。
LLM_URL=http://127.0.0.1:11441
LLM_MODEL_ID=gemma4-31b-it-heretic-4bit-mtp

# 1 リクエストのタイムアウト (秒)。再思考時は思考分だけ出力が長くなる
LLM_TIMEOUT_SEC=300

# 出力が検証を通らなかったときに再思考させる回数 (0 で再試行なし)
STAGE_RETRY_LIMIT=2

# ── 埋め込み (RAG) ────────────────────────────────────────────
# モデルを変えたら rag_chunks を全件再埋め込みすること
#   uv run ai-agents/embed_chunks.py --reembed-all
EMBED_URL=http://127.0.0.1:11455
EMBED_MODEL_ID=bge-m3-q8

# ── 旧設定 (廃止) ─────────────────────────────────────────────
# LLAMA_SERVER / MODEL_GM / MODEL_NPC / MODEL_EMBED /
# GM_URL / SUPPORT_URL / NPC_A_URL / NPC_B_URL / NPC_C_URL は使われない
